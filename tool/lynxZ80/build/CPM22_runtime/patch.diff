--- CPM22.Z80
+++ CPM22.ASM
@@ -41,7 +41,7 @@ DEL	EQU	7FH		;rubout
 ;
 	ORG	(MEM-7)*1024
 ;
-CBASE:	JP	COMMAND		;execute command processor (ccp).
+CBASE:	JP	COLD_BOOT	;execute cold boot sign-on and command processor.
 	JP	CLEARBUF	;entry to empty input buffer before starting ccp.
 
 ;
@@ -100,6 +100,7 @@ PLINE2:	LD	A,(HL)
 	CALL	PRINT
 	POP	HL
 	JP	PLINE2
+
 ;
 ;   Routine to reset the disk system.
 ;
@@ -630,7 +631,8 @@ COMMAND:LD	SP,CCPSTACK	;setup stack area.
 CMMND1:	LD	SP,CCPSTACK	;set stack straight.
 	CALL	CRLF		;start a new line on the screen.
 	CALL	GETDSK		;get current drive.
-	ADD	A,'a'
+	ADD	A,'A'
+	AND	5FH		;force upper-case drive letter.
 	CALL	PRINT		;print current drive.
 	LD	A,'>'
 	CALL	PRINT		;and add prompt.
@@ -2040,7 +2042,7 @@ SHIFTR1:DEC	C
 CHECKSUM: LD	C,128		;length of buffer.
 	LD	HL,(DIRBUF)	;get its location.
 	XOR	A		;clear summation byte.
-CHKSUM1:ADD	A,M		;and compute sum ignoring carries.
+CHKSUM1:ADD	A,(HL)		;and compute sum ignoring carries.
 	INC	HL
 	DEC	C
 	JP	NZ,CHKSUM1
@@ -2165,7 +2167,7 @@ MOREFLS:LD	HL,(FILEPOS)	;we are here.
 	SUB	(HL)
 	INC	HL
 	LD	A,D
-	SBC	A,M		;set carry if no more names.
+	SBC	A,(HL)		;set carry if no more names.
 	RET	
 ;
 ;   Call this routine to prevent (SCRATCH1) from being greater
@@ -3337,10 +3339,10 @@ RANSIZ1:CALL	CKFILPOS	;is there an extent to process?
 	SUB	(HL)		;in the fcb represent a larger size than
 	INC	HL		;this extent does.
 	LD	A,B
-	SBC	A,M
+	SBC	A,(HL)
 	INC	HL
 	LD	A,E
-	SBC	A,M
+	SBC	A,(HL)
 	JP	C,RANSIZ2
 	LD	(HL),E		;we found a larger (in size) extent.
 	DEC	HL		;stuff these values into fcb.
@@ -3731,8 +3733,64 @@ READ:	JP	0
 WRITE:	JP	0
 PRSTAT:	JP	0
 SECTRN:	JP	0
+
+;
+;   Print the CP/M sign-on only through CBASE. WBOOT enters at CBASE+3,
+;   so warm boots bypass this routine. Keep the standard CP/M and BIOS
+;   addresses unchanged by placing this cold-only code in reserved memory.
+;
+	ORG	MEM*1024
+COLD_BOOT:
+	LD	SP,CCPSTACK
+	LD	HL,COLD_SCREEN_INIT
+	CALL	COLD_PRINT_STRING
+	LD	A,(CBASE-TBASE)/1024
+	LD	B,'0'
+COLD_TPA_TENS:
+	CP	10
+	JR	C,COLD_TPA_DIGITS
+	SUB	10
+	INC	B
+	JR	COLD_TPA_TENS
+COLD_TPA_DIGITS:
+	LD	C,A
+	LD	A,B
+	CP	'0'
+	CALL	NZ,COLD_CONOUT
+	LD	A,C
+	ADD	A,'0'
+	CALL	COLD_CONOUT
+	LD	HL,COLD_SIGNON_TAIL
+	CALL	COLD_PRINT_STRING
+	LD	C,0
+	JP	COMMAND
+
+COLD_PRINT_STRING:
+	LD	A,(HL)
+	OR	A
+	RET	Z
+	INC	HL
+	PUSH	HL
+	CALL	COLD_CONOUT
+	POP	HL
+	JR	COLD_PRINT_STRING
+
+COLD_CONOUT:
+	PUSH	BC
+	LD	C,A
+	CALL	CONOUT
+	POP	BC
+	RET
+
+COLD_SCREEN_INIT:
+	DEFB	01BH,'[2J',01BH,'[H',0
+COLD_SIGNON_TAIL:
+	DEFB	'K CP/M Ver. 2.2 for Lynx',CR,LF
+	DEFB	'(C) 1979 Digital Research, Reprogram by yosi',0
+COLD_BOOT_AREA_END:
+
 ;
 ;*
 ;******************   E N D   O F   C P / M   *****************
 ;*
-
+	END
